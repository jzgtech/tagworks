; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="TagWorks"
config/version="0.0.7"
run/main_scene="uid://dcgh5l37a2nx2"
run/use_game_mode=false
config/use_custom_user_dir=true
config/custom_user_dir_name="TagWorks"
config/features=PackedStringArray("4.8", "Mobile")
run/low_processor_mode=true
run/low_processor_mode_sleep_usec=10000
boot_splash/show_image=false
config/icon="uid://dxy3mppjwsw77"
config/windows_native_icon="res://resources/icon.ico"

[audio]

driver/driver="Dummy"

[autoload]

LogManager="*uid://c37t4sw6icwbe"
SignalLogger="*uid://bdvrrb4qxle6u"
IntentBus="*uid://cjix3rt8scmxg"
AppState="*uid://bbum4fh6utg2j"
AppSettings="*uid://b6n2e2ypxqaao"
AppConfig="*uid://j7umd53r33nx"
OpcUaManager="*uid://8phiu00ahgg7"
RecentProjects="*uid://cf5q8hhp6qhwy"
ProjectManager="*uid://cxcfp36bffx2p"
ReactiveTypeRegistry="*uid://u4m6loh0vxlf"
ReactiveWidgetFactory="*uid://cay55wsepjx2n"
WidgetExtensionRegistry="*uid://b4ff3mgf2yis"
WindowManager="*uid://bh8balwa2xnfd"
ToastManager="*uid://bqcsu7pmixvon"
BreakpointManager="*uid://d2l4fm0fid8ef"
MenuActions="*uid://bkpdr76avq65g"
DiscoveryHost="*uid://c36ui6u7hy0nx"
TransferManager="*uid://6lycknfyxysu"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/inferred_declaration=1

[display]

window/size/viewport_width=650
window/size/viewport_height=550
window/size/resizable=false
window/size/borderless=true
window/size/transparent=true
window/size/extend_to_title=true
window/size/minimize_disabled=true
window/size/maximize_disabled=true
window/size/enable_toggle_fullscreen_shortcut=false
window/subwindows/embed_subwindows=false
window/stretch/aspect="ignore"
window/per_pixel_transparency/allowed=true
window/handheld/orientation=6
window/ios/hide_status_bar=false

[editor_plugins]

enabled=PackedStringArray("res://addons/theme_switcher/plugin.cfg", "res://addons/version_bumper/plugin.cfg")

[file_customization]

folder_colors={
"res://autoloads/": "pink",
"res://reactive/": "orange",
"res://scenes/": "pink",
"res://scenes/dialogs/": "red",
"res://tests/": "green",
"res://translations/": "teal",
"res://ui/toast/": "yellow",
"res://widget_sdk/": "purple",
"res://widget_sdk/components/": "teal",
"res://widgets/": "purple"
}

[gui]

theme/custom="res://resources/dark_theme.tres"

[internationalization]

locale/translations=PackedStringArray("res://translations/en.po", "res://translations/de.po", "res://translations/fr.po")

[physics]

3d/physics_engine="Dummy"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true

[version_bumper]

display_mode=0
