; =============================================================================
; godot_opcua.gdextension  (v4 — iOS now loads the .xcframework produced by the
; SConstruct; new class OpcUaNodeId is registered from the same library)
; =============================================================================

[configuration]
entry_symbol         = "opcua_library_init"
compatibility_minimum = "4.1"
reloadable           = true

[libraries]

; ── Linux ─────────────────────────────────────────────────────────────────────
linux.debug.x86_64          = "res://bin/libgodot_opcua.linux.template_debug.x86_64.so"
linux.release.x86_64        = "res://bin/libgodot_opcua.linux.template_release.x86_64.so"
linux.debug.arm64           = "res://bin/libgodot_opcua.linux.template_debug.arm64.so"
linux.release.arm64         = "res://bin/libgodot_opcua.linux.template_release.arm64.so"

; ── Windows ───────────────────────────────────────────────────────────────────
windows.debug.x86_64        = "res://bin/libgodot_opcua.windows.template_debug.x86_64.dll"
windows.release.x86_64      = "res://bin/libgodot_opcua.windows.template_release.x86_64.dll"
windows.debug.x86_32        = "res://bin/libgodot_opcua.windows.template_debug.x86_32.dll"
windows.release.x86_32      = "res://bin/libgodot_opcua.windows.template_release.x86_32.dll"

; ── Android ───────────────────────────────────────────────────────────────────
android.debug.arm64-v8a     = "res://bin/libgodot_opcua.android.template_debug.arm64.so"
android.release.arm64-v8a   = "res://bin/libgodot_opcua.android.template_release.arm64.so"
android.debug.x86_64        = "res://bin/libgodot_opcua.android.template_debug.x86_64.so"
android.release.x86_64      = "res://bin/libgodot_opcua.android.template_release.x86_64.so"

; ── iOS (xcframework: device arm64 + simulator slices, built by the SConstruct) ──
ios.debug                   = "res://bin/godot_opcua.ios.template_debug.xcframework"
ios.release                 = "res://bin/godot_opcua.ios.template_release.xcframework"

; ── macOS (uncomment and build with platform=macos when needed) ───────────────
;macos.debug                 = "res://bin/libgodot_opcua.macos.template_debug.universal.a"
;macos.release               = "res://bin/libgodot_opcua.macos.template_release.universal.a"

[dependencies]
; The iOS key must match the [libraries] key above (ios.debug / ios.release).
ios.debug = {
    "res://bin/libgodot-cpp.ios.template_debug.arm64.a": ""
}
ios.release = {
    "res://bin/libgodot-cpp.ios.template_release.arm64.a": ""
}
